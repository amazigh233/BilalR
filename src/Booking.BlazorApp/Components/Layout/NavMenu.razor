                        <summary>
                            <span>Boekhouding</span>
                            <span class="nav-group-count">4</span>
                        </summary>
                        <div class="nav-group-items">
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/boekhouding" Match="NavLinkMatch.All">
                                    <span class="nav-icon nav-icon-analytics" aria-hidden="true"></span> Overzicht
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/boekhouding/inbox">
                                    <span class="nav-icon nav-icon-orders" aria-hidden="true"></span> Controle-inbox
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/boekhouding/boekingen">
                                    <span class="nav-icon nav-icon-calendar" aria-hidden="true"></span> Boekingen
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/boekhouding/importeren">
                                    <span class="nav-icon nav-icon-integrations" aria-hidden="true"></span> Importeren
                                </NavLink>
                            </div>
                        </div>
                    </details>

                    <details class="nav-group" open="@IsSectionActive("admin/bezorging", "admin/restaurant", "admin/google-business")">
                        <summary>
                            <span>Instellingen</span>
                            <span class="nav-group-count">3</span>
                        </summary>
                        <div class="nav-group-items">
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/bezorging">
                                    <span class="nav-icon nav-icon-integrations" aria-hidden="true"></span> Bezorgintegraties
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/google-business" Match="NavLinkMatch.All">
                                    <span class="nav-icon nav-icon-integrations" aria-hidden="true"></span> Google Business
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/restaurant">
                                    <span class="nav-icon nav-icon-store" aria-hidden="true"></span> Restaurant
                                </NavLink>
                            </div>
                        </div>
                    </details>
                </AuthorizeView>

                <AuthorizeView Roles="SuperAdmin">
                    <div class="nav-section-label">Platform</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin/restaurant-accounts/create">
                            <span class="nav-icon nav-icon-plus" aria-hidden="true"></span> Restaurantaccount
                        </NavLink>
                    </div>
                </AuthorizeView>
            </Authorized>
            <NotAuthorized>
                <div class="nav-section-label">Start</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="nav-icon nav-icon-home" aria-hidden="true"></span> Zambiq
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="login">
                        <span class="nav-icon nav-icon-login" aria-hidden="true"></span> Inloggen
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
    <div class="nav-footer">
        <span class="nav-footer-signal" aria-hidden="true"></span>
        <span>
            <strong>Service mode</strong>
            <small>Alle systemen operationeel</small>
        </span>
    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private bool IsSectionActive(params string[] routePrefixes)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        return routePrefixes.Any(prefix =>
            relativePath.Equals(prefix.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ||
            relativePath.StartsWith($"{prefix.TrimEnd('/')}/", StringComparison.OrdinalIgnoreCase));
    }

    private static bool TryGetRestaurantId(ClaimsPrincipal user, out Guid restaurantId)
    {
        var value = user.FindFirst(BookingAuthClaimTypes.RestaurantId)?.Value;
        return Guid.TryParse(value, out restaurantId);
    }
}
