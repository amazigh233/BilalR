<div class="brand-row">
    <div class="brand-mark">Z<span aria-hidden="true"></span></div>
    <div class="brand-copy">
        <a class="navbar-brand" href="/admin">Zambiq</a>
        <div class="brand-subtitle">Service operating system</div>
    </div>
</div>

<input type="checkbox" title="Navigatiemenu openen" aria-label="Navigatiemenu openen" class="navbar-toggler" />

<div class="nav-scrollable" onclick="if (event.target.closest('a')) document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized Context="authState">
                <AuthorizeView Roles="Owner,Staff">
                    <div class="nav-section-label">Werkdag</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin" Match="NavLinkMatch.All">
                            <span class="nav-icon nav-icon-home" aria-hidden="true"></span> Home
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Owner,Staff">
                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin/reservations">
                            <span class="nav-icon nav-icon-calendar" aria-hidden="true"></span> Reserveringen
                        </NavLink>
                    </div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin/bezorgorders">
                            <span class="nav-icon nav-icon-orders" aria-hidden="true"></span> Bezorgorders
                        </NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Roles="Staff">
                    @if (TryGetRestaurantId(authState.User, out var staffRestaurantId))
                    {
                        <div class="nav-item">
                            <NavLink class="nav-link" href="@($"booking/{staffRestaurantId}")">
                                <span class="nav-icon nav-icon-link" aria-hidden="true"></span> Publieke pagina
                            </NavLink>
                        </div>
                    }
                </AuthorizeView>

                <AuthorizeView Roles="Owner">
                    <div class="nav-item">
                        <NavLink class="nav-link" href="admin/analytics">
                            <span class="nav-icon nav-icon-analytics" aria-hidden="true"></span> Inzichten
                        </NavLink>
                    </div>

                    <div class="nav-section-label">Beheer</div>
                    <details class="nav-group" open="@IsSectionActive("admin/opening-hours", "admin/widget", "admin/tafels", "booking/")">
                        <summary>
                            <span>Reserveringsbeheer</span>
                            <span class="nav-group-count">5</span>
                        </summary>
                        <div class="nav-group-items">
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/opening-hours">
                                    <span class="nav-icon nav-icon-clock" aria-hidden="true"></span> Openingstijden
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/tafels" Match="NavLinkMatch.All">
                                    <span class="nav-icon nav-icon-table" aria-hidden="true"></span> Tafels
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/tafels/plattegrond">
                                    <span class="nav-icon nav-icon-table" aria-hidden="true"></span> Plattegrond
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/widget">
                                    <span class="nav-icon nav-icon-widget" aria-hidden="true"></span> Booking widget
                                </NavLink>
                            </div>
                            @if (TryGetRestaurantId(authState.User, out var restaurantId))
                            {
                                <div class="nav-item">
                                    <NavLink class="nav-link" href="@($"booking/{restaurantId}")">
                                        <span class="nav-icon nav-icon-link" aria-hidden="true"></span> Publieke pagina
                                    </NavLink>
                                </div>
