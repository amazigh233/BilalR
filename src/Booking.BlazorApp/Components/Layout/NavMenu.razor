                            <span>Team</span>
                            <span class="nav-group-count">4</span>
                        </summary>
                        <div class="nav-group-items">
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/staff">
                                    <span class="nav-icon nav-icon-users" aria-hidden="true"></span> Medewerkers
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/schedule">
                                    <span class="nav-icon nav-icon-schedule" aria-hidden="true"></span> Rooster
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/availability">
                                    <span class="nav-icon nav-icon-availability" aria-hidden="true"></span> Beschikbaarheid
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="admin/leave">
                                    <span class="nav-icon nav-icon-leave" aria-hidden="true"></span> Verlof
                                </NavLink>
                            </div>
                        </div>
                    </details>
                </AuthorizeView>

                <AuthorizeView Roles="Owner,Staff">
                    <details class="nav-group" open="@IsSectionActive("mijn-rooster", "mijn-beschikbaarheid", "mijn-verlof")">
