                                    <span class="nav-icon nav-icon-schedule" aria-hidden="true"></span> Mijn rooster
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="mijn-beschikbaarheid">
                                    <span class="nav-icon nav-icon-availability" aria-hidden="true"></span> Mijn beschikbaarheid
                                </NavLink>
                            </div>
                            <div class="nav-item">
                                <NavLink class="nav-link" href="mijn-verlof">
                                    <span class="nav-icon nav-icon-leave" aria-hidden="true"></span> Mijn verlof
