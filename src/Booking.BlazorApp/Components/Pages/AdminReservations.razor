@page "/admin/reservations"
@attribute [Authorize(Roles = "Owner,Staff")]
@rendermode InteractiveServer
@inject RestaurantApiClient RestaurantApi
@inject ReservationApiClient ReservationApi
@inject TableApiClient TableApi
@inject AuthenticationStateProvider AuthState

<PageTitle>Reserveringen</PageTitle>

<PageHeader Eyebrow="Reserveringen"
            Title="@(_restaurant?.Name ?? "Reserveringen")"
            Description="Bekijk aankomende gasten, filter het overzicht en werk reserveringsstatussen bij.">
    <Actions>
        <button class="btn btn-quiet" type="button" @onclick="LoadAsync" disabled="@_isLoading">Vernieuwen</button>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success">@_successMessage</div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_isLoading)
{
    <div class="loading-state">Reserveringen laden...</div>
}
else if (!_loadFailed)
{
    <SectionCard Title="Filters"
                 Subtitle="Vind snel de reserveringen die aandacht nodig hebben."
                 CssClass="filter-card"
                 BodyCssClass="reservation-filter-grid">
        <div class="form-field">
            <label for="reservation-date-filter">Datum</label>
            <input id="reservation-date-filter"
                   class="form-control"
                   type="date"
                   value="@_dateFilter"
                   @onchange="eventArgs => _dateFilter = eventArgs.Value?.ToString() ?? string.Empty" />
        </div>
        <div class="form-field">
            <label for="reservation-status-filter">Status</label>
            <select id="reservation-status-filter" class="form-select" @bind="_statusFilter">
                <option value="">Alle statussen</option>
                @foreach (var status in Enum.GetValues<ReservationStatus>())
                {
                    <option value="@status">@GetStatusDisplayLabel(status)</option>
                }
            </select>
        </div>
        <button class="btn btn-quiet align-self-end" type="button" @onclick="ClearFilters">Filters wissen</button>
    </SectionCard>

    <SectionCard Title="Reserveringsoverzicht"
                 Subtitle="@($"{FilteredReservations.Count()} reserveringen gevonden")"
                 CssClass="reservation-table-card"
                 BodyCssClass="flush-card-body">
        @if (!FilteredReservations.Any())
        {
            <EmptyState Icon="icon-calendar"
                        Title="Geen reserveringen gevonden"
                        Description="Pas de filters aan of vernieuw het overzicht." />
        }
        else
        {
            <div class="table-responsive">
                <table class="table reservation-table align-middle">
                    <thead>
                        <tr>
                            <th>Datum en tijd</th>
                            <th>Gast</th>
                            <th>Groep</th>
                            <th>Status</th>
                            @if (_isOwner)
                            {
                                <th>Tafel</th>
                            }
                            <th>Opmerking</th>
                            <th class="text-end">Acties</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in FilteredReservations)
                        {
                            <tr>
                                <td data-label="Datum en tijd">
                                    <strong>@reservation.ReservationDateTime.ToString("dd MMM yyyy")</strong>
                                    <div class="table-secondary-text">@reservation.ReservationDateTime.ToString("HH:mm") uur</div>
                                </td>
                                <td data-label="Gast">
                                    <strong>@reservation.CustomerName</strong>
                                    <div class="table-secondary-text">@reservation.CustomerEmail</div>
                                    <div class="table-secondary-text">@(reservation.CustomerPhoneNumber ?? "Geen telefoonnummer")</div>
                                </td>
                                <td data-label="Groep">
                                    <span class="party-size">@reservation.PartySize</span>
                                    <span class="table-secondary-text">personen</span>
                                </td>
                                <td data-label="Status">
                                    <StatusBadge Label="@GetStatusDisplayLabel(reservation.Status)"
                                                 Tone="@GetStatusTone(reservation.Status)" />
                                </td>
                                @if (_isOwner)
                                {
                                    <td data-label="Tafel">
                                        @if (_assigningReservationIds.Contains(reservation.Id))
                                        {
                                            <span class="text-muted small">Opslaan...</span>
                                        }
                                        else
                                        {
                                            <select class="form-select form-select-sm table-assign-select"
                                                    value="@(reservation.TableId?.ToString() ?? "")"
                                                    @onchange="args => AssignTableAsync(reservation.Id, args.Value?.ToString())">
                                                <option value="">— Geen tafel —</option>
                                                @foreach (var table in ActiveTables)
                                                {
                                                    <option value="@table.Id">@table.Name (@table.Capacity p.)</option>
                                                }
                                            </select>
                                            @if (_tableAssignErrors.TryGetValue(reservation.Id, out var assignError))
                                            {
                                                <div class="text-danger small mt-1">@assignError</div>
                                            }
                                        }
                                    </td>
                                }
                                <td data-label="Opmerking" class="reservation-note">
                                    @(string.IsNullOrWhiteSpace(reservation.Note) ? "Geen opmerking" : reservation.Note)
                                </td>
                                <td data-label="Acties">
                                    <div class="table-actions">
                                        @foreach (var status in ChangeableStatuses)
                                        {
                                            <button class="btn btn-action btn-sm @GetActionClass(status)"
                                                    type="button"
                                                    disabled="@IsStatusButtonDisabled(reservation, status)"
                                                    @onclick="() => ChangeStatusAsync(reservation.Id, status)">
                                                @GetStatusActionLabel(status)
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </SectionCard>
}

@code {
    private static readonly ReservationStatus[] ChangeableStatuses =
    [
        ReservationStatus.Confirmed,
        ReservationStatus.Cancelled,
        ReservationStatus.NoShow
    ];

    private RestaurantDto? _restaurant;
    private List<ReservationDto> _reservations = [];
    private List<TableDto> _tables = [];
    private readonly HashSet<Guid> _updatingReservationIds = [];
    private readonly HashSet<Guid> _assigningReservationIds = [];
    private readonly Dictionary<Guid, string> _tableAssignErrors = [];
    private bool _isLoading = true;
    private bool _loadFailed;
    private bool _isOwner;
    private string _dateFilter = string.Empty;
    private string _statusFilter = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;

    private IEnumerable<TableDto> ActiveTables => _tables.Where(t => t.IsActive);

    private IEnumerable<ReservationDto> FilteredReservations
    {
        get
        {
            var query = _reservations.AsEnumerable();

            if (DateOnly.TryParse(_dateFilter, out var date))
            {
                query = query.Where(reservation =>
                    DateOnly.FromDateTime(reservation.ReservationDateTime) == date);
            }

            if (Enum.TryParse<ReservationStatus>(_statusFilter, out var status))
            {
                query = query.Where(reservation => reservation.Status == status);
            }

            return query.OrderBy(reservation => reservation.ReservationDateTime);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _isOwner = authState.User.IsInRole("Owner");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadFailed = false;
        _errorMessage = null;

        try
        {
            var restaurantTask = RestaurantApi.GetCurrentAsync();
            var reservationsTask = ReservationApi.GetCurrentRestaurantAsync();
            var tablesTask = _isOwner ? TableApi.GetAllAsync() : Task.FromResult<IReadOnlyList<TableDto>>([]);

            await Task.WhenAll(restaurantTask, reservationsTask, tablesTask);

            _restaurant = await restaurantTask;
            _reservations = (await reservationsTask).ToList();
            _tables = (await tablesTask).ToList();
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
            _loadFailed = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AssignTableAsync(Guid reservationId, string? tableIdString)
    {
        _assigningReservationIds.Add(reservationId);
        _tableAssignErrors.Remove(reservationId);

        try
        {
            var tableId = string.IsNullOrEmpty(tableIdString) ? (Guid?)null : Guid.Parse(tableIdString);
            await TableApi.AssignToReservationAsync(reservationId, tableId);

            var index = _reservations.FindIndex(r => r.Id == reservationId);
            if (index >= 0)
            {
                _reservations[index] = _reservations[index] with { TableId = tableId };
            }
        }
        catch (ApiClientException exception)
        {
            _tableAssignErrors[reservationId] = exception.Message;
        }
        finally
        {
            _assigningReservationIds.Remove(reservationId);
        }
    }

    private async Task ChangeStatusAsync(Guid reservationId, ReservationStatus status)
    {
        _errorMessage = null;
        _successMessage = null;
        _updatingReservationIds.Add(reservationId);

        try
        {
            var updated = await ReservationApi.ChangeCurrentRestaurantStatusAsync(reservationId, status);
            var index = _reservations.FindIndex(reservation => reservation.Id == reservationId);
            if (index >= 0)
            {
                _reservations[index] = updated;
            }

            _successMessage = "Status bijgewerkt.";
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _updatingReservationIds.Remove(reservationId);
        }
    }

    private bool IsStatusButtonDisabled(ReservationDto reservation, ReservationStatus status)
    {
        return reservation.Status == status || _updatingReservationIds.Contains(reservation.Id);
    }

    private void ClearFilters()
    {
        _dateFilter = string.Empty;
        _statusFilter = string.Empty;
    }

    private static string GetStatusActionLabel(ReservationStatus status)
    {
        return status switch
        {
            ReservationStatus.Confirmed => "Bevestigen",
            ReservationStatus.Cancelled => "Annuleren",
            ReservationStatus.NoShow => "No-show",
            _ => status.ToString()
        };
    }

    private static string GetStatusDisplayLabel(ReservationStatus status)
    {
        return status switch
        {
            ReservationStatus.New => "Nieuw",
            ReservationStatus.Confirmed => "Bevestigd",
            ReservationStatus.Cancelled => "Geannuleerd",
            ReservationStatus.NoShow => "No-show",
            _ => status.ToString()
        };
    }

    private static StatusTone GetStatusTone(ReservationStatus status)
    {
        return status switch
        {
            ReservationStatus.New => StatusTone.Warning,
            ReservationStatus.Confirmed => StatusTone.Success,
            ReservationStatus.Cancelled => StatusTone.Danger,
            ReservationStatus.NoShow => StatusTone.Neutral,
            _ => StatusTone.Neutral
        };
    }

    private static string GetActionClass(ReservationStatus status)
    {
        return status switch
        {
            ReservationStatus.Confirmed => "btn-action-success",
            ReservationStatus.Cancelled => "btn-action-danger",
            _ => string.Empty
        };
    }
}
