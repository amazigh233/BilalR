@page "/login"
@layout Layout.PublicLayout
@attribute [AllowAnonymous]

<PageTitle>Inloggen</PageTitle>

<section class="login-shell">
    <div class="login-intro">
        <div class="login-intro-number">ZAMBIQ / SERVICE OS</div>
        <p class="eyebrow">Alles klaar voor vandaag</p>
        <h1>Neem controle over de service.</h1>
        <p>Reserveringen, planning en teamwerk samen in één scherpe, rustige werkplek.</p>
        <div class="login-feature-list">
            <span><b>01</b> Reserveringen</span>
            <span><b>02</b> Team</span>
            <span><b>03</b> Operatie</span>
        </div>
    </div>

    <div class="login-panel">
        <div class="login-brand">
            <div class="login-brand-mark">Z</div>
            <div>
                <p class="eyebrow mb-1">Zambiq workspace</p>
                <strong>Zakelijke toegang</strong>
            </div>
        </div>
        <h2>Inloggen</h2>
        <p class="text-muted mb-4">Gebruik je account om verder te gaan.</p>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="alert alert-danger">@Error</div>
        }

        @if (LoggedOut)
        {
            <div class="alert alert-success">Je bent uitgelogd.</div>
        }

        <form method="post" action="/auth/login">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@SafeReturnUrl" />

            <div class="form-field">
                <label for="email">E-mail</label>
                <input id="email"
                       class="form-control"
                       name="Email"
                       type="email"
                       autocomplete="username"
                       placeholder="naam@restaurant.nl"
                       required />
            </div>

            <div class="form-field">
                <label for="password">Wachtwoord</label>
                <input id="password"
                       class="form-control"
                       name="Password"
                       type="password"
                       autocomplete="current-password"
                       required />
            </div>

            <button class="btn btn-primary w-100" type="submit">Open mijn werkplek <span aria-hidden="true">&rarr;</span></button>
        </form>
        <p class="login-panel-footnote">Beveiligde toegang tot jouw restaurantomgeving.</p>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "loggedOut")]
    public bool LoggedOut { get; set; }

    private string SafeReturnUrl
    {
        get
        {
            if (string.IsNullOrWhiteSpace(ReturnUrl) ||
                !Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative) ||
                !ReturnUrl.StartsWith('/') ||
                ReturnUrl.StartsWith("//", StringComparison.Ordinal))
            {
                return "/admin";
            }

            return ReturnUrl;
        }
    }
}
