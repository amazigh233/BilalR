@page "/booking/{RestaurantId:guid}"
@page "/embed/booking/{RestaurantId:guid}"
@layout Layout.PublicLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject RestaurantApiClient RestaurantApi
@inject AvailabilityApiClient AvailabilityApi
@inject ReservationApiClient ReservationApi
@inject NavigationManager Navigation

<PageTitle>Reserveren</PageTitle>

<div class="public-booking-page @(IsEmbedded ? "is-embedded" : null)" style="@BrandingStyle">
    <section class="public-booking-hero">
        <div class="restaurant-identity-card">
            @if (string.IsNullOrWhiteSpace(_restaurant?.WidgetLogoUrl))
            {
                <div class="restaurant-monogram">@GetRestaurantInitial()</div>
            }
            else
            {
                <div class="restaurant-logo-frame">
                    <img class="restaurant-logo"
                         src="@_restaurant.WidgetLogoUrl"
                         alt="@($"Logo van {_restaurant.Name}")" />
                </div>
            }
            <div class="restaurant-identity-copy">
                <p class="eyebrow">Online reserveren</p>
                <h1>@(_restaurant?.Name ?? "Restaurant")</h1>
                <p>@WelcomeText</p>
            </div>
            <div class="booking-confidence">
                <span>Veilig verstuurd</span>
                <span>Direct bevestigd door het restaurant</span>
            </div>
        </div>
    </section>

    @if (_isLoading)
    {
        <div class="loading-state">Restaurant laden...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadErrorMessage))
    {
        <div class="alert alert-danger">@_loadErrorMessage</div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_successMessage))
        {
            <div class="booking-result booking-result-success">
                <span class="booking-result-icon" aria-hidden="true">✓</span>
                <div>
                    <strong>Je reserveringsaanvraag is ontvangen</strong>
                    <p>@_successMessage</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="booking-result booking-result-error">
                <span class="booking-result-icon" aria-hidden="true">!</span>
                <div>
                    <strong>Controleer je reservering</strong>
                    <p>@_errorMessage</p>
                </div>
            </div>
        }

        <section class="booking-shell">
            <div class="booking-shell-header">
                <div>
                    <p class="eyebrow">Reserveringsaanvraag</p>
                    <h2>Reserveer je tafel</h2>
                    <p>Vul je gegevens en gewenste moment in.</p>
                </div>
                <span class="booking-step">1 aanvraag</span>
            </div>

            <EditForm Model="_form" FormName="public-booking" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="booking-form-section">
                    <div class="booking-form-section-heading">
                        <span>1</span>
                        <div>
                            <strong>Jouw gegevens</strong>
                            <small>Zo kan het restaurant contact opnemen.</small>
                        </div>
                    </div>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="customer-name">Naam</label>
                            <InputText id="customer-name" class="form-control" @bind-Value="_form.CustomerName" />
                        </div>

                        <div class="form-field">
                            <label for="customer-phone">Telefoon <span class="optional-label">optioneel</span></label>
                            <InputText id="customer-phone" class="form-control" @bind-Value="_form.PhoneNumber" />
                        </div>

                        <div class="form-field form-field-wide">
                            <label for="customer-email">E-mail</label>
                            <InputText id="customer-email" class="form-control" type="email" @bind-Value="_form.Email" />
                        </div>
                    </div>
                </div>

                <div class="booking-form-section">
                    <div class="booking-form-section-heading">
                        <span>2</span>
                        <div>
                            <strong>Kies je moment</strong>
                            <small>Het restaurant controleert direct de beschikbaarheid.</small>
                        </div>
                    </div>
                    <div class="form-grid booking-time-grid">
                        <div class="form-field">
                            <label for="party-size">Aantal personen</label>
                            <InputNumber id="party-size" class="form-control" @bind-Value="_form.PartySize" />
                        </div>

                        <div class="form-field">
                            <label for="reservation-date">Datum</label>
                            <InputDate id="reservation-date" class="form-control" @bind-Value="_form.Date" />
                        </div>

                        <div class="form-field">
                            <label for="reservation-time">Tijd</label>
                            <input id="reservation-time"
                                   class="form-control"
                                   type="time"
                                   value="@_form.Time"
                                   @onchange="eventArgs => _form.Time = eventArgs.Value?.ToString() ?? string.Empty" />
                        </div>
                    </div>
                </div>

                <div class="form-field">
                    <label for="reservation-note">Opmerking <span class="optional-label">optioneel</span></label>
                    <InputTextArea id="reservation-note"
                                   class="form-control"
                                   rows="3"
                                   placeholder="Bijvoorbeeld allergieën of een speciale gelegenheid"
                                   @bind-Value="_form.Note" />
                </div>

                <button class="btn btn-primary booking-submit" type="submit" disabled="@_isSubmitting">
                    @(_isSubmitting ? "Beschikbaarheid controleren..." : "Reserveringsaanvraag versturen")
                </button>
                <p class="booking-submit-helper">Door te versturen vraag je een reservering aan bij het restaurant.</p>
            </EditForm>
        </section>
    }
</div>

@code {
    [Parameter]
    public Guid RestaurantId { get; set; }

    private RestaurantDto? _restaurant;
    private BookingForm _form = new();
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _loadErrorMessage;
    private string? _errorMessage;
    private string? _successMessage;
    private bool IsEmbedded => Navigation.ToBaseRelativePath(Navigation.Uri)
        .StartsWith("embed/", StringComparison.OrdinalIgnoreCase);
    private string BrandingStyle =>
        $"--booking-primary: {_restaurant?.WidgetPrimaryColor ?? "#2f6b4f"}; " +
        $"--booking-accent: {_restaurant?.WidgetAccentColor ?? "#d9a05b"};";
    private string WelcomeText => string.IsNullOrWhiteSpace(_restaurant?.WidgetWelcomeText)
        ? "Kies een passend moment. Je aanvraag wordt direct doorgestuurd naar het restaurant."
        : _restaurant.WidgetWelcomeText;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _restaurant = await RestaurantApi.GetByIdAsync(RestaurantId);
        }
        catch (ApiClientException exception)
        {
            _loadErrorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            if (!TimeOnly.TryParseExact(
                _form.Time,
                "HH:mm",
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var time))
            {
                _errorMessage = "Controleer de tijd.";
                return;
            }

            var reservationDateTime = _form.Date.Date + time.ToTimeSpan();
            if (reservationDateTime <= DateTime.Now)
            {
                _errorMessage = "Kies een datum en tijd in de toekomst.";
                return;
            }

            var availability = await AvailabilityApi.CheckAsync(
                RestaurantId,
                reservationDateTime,
                _form.PartySize);

            if (!availability.IsAvailable)
            {
                _errorMessage = availability.Reason ?? "Dit tijdstip is niet beschikbaar.";
                return;
            }

            var reservation = await ReservationApi.CreateAsync(new CreateReservationRequest(
                RestaurantId,
                reservationDateTime,
                _form.PartySize,
                new CustomerRequest(
                    _form.CustomerName,
                    _form.Email,
                    _form.PhoneNumber),
                _form.Note));

            _successMessage = $"Reservering ontvangen voor {reservation.ReservationDateTime:dd-MM-yyyy HH:mm}.";
            _form = new BookingForm();
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class BookingForm
    {
        [Required(ErrorMessage = "Naam is verplicht.")]
        public string CustomerName { get; set; } = string.Empty;

        public string? PhoneNumber { get; set; }

        [Required(ErrorMessage = "E-mail is verplicht.")]
        [EmailAddress(ErrorMessage = "Gebruik een geldig e-mailadres.")]
        public string Email { get; set; } = string.Empty;

        [Required]
        public DateTime Date { get; set; } = DateTime.Today;

        [Required(ErrorMessage = "Tijd is verplicht.")]
        public string Time { get; set; } = "19:00";

        [Range(1, 50, ErrorMessage = "Aantal personen moet minimaal 1 zijn.")]
        public int PartySize { get; set; } = 2;

        [StringLength(1000, ErrorMessage = "Opmerking mag maximaal 1000 tekens zijn.")]
        public string? Note { get; set; }
    }

    private string GetRestaurantInitial()
    {
        var name = _restaurant?.Name;
        return string.IsNullOrWhiteSpace(name)
            ? "R"
            : char.ToUpperInvariant(name.Trim()[0]).ToString();
    }
}
