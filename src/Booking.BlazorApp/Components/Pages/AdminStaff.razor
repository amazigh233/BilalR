@page "/admin/staff"
@attribute [Authorize(Roles = "Owner")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@inject StaffApiClient StaffApi

<PageTitle>Medewerkers</PageTitle>

<PageHeader Eyebrow="Team"
            Title="Medewerkers"
            Description="Beheer toegang voor je team en houd actieve accounts overzichtelijk.">
    <Actions>
        <a class="btn btn-quiet" href="/admin">Terug naar dashboard</a>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <div class="alert alert-success">@_successMessage</div>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

<div class="responsive-grid staff-layout">
    <SectionCard Title="@(_editingUserId is null ? "Medewerker toevoegen" : "Medewerker bewerken")"
                 Subtitle="@(_editingUserId is null ? "Maak een account aan met een tijdelijk wachtwoord." : "Pas naam, telefoon of uurloon aan.")"
                 CssClass="staff-form-card">
        <EditForm Model="_form" FormName="create-staff" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-field">
                <label for="staff-name">Naam</label>
                <InputText id="staff-name" class="form-control" @bind-Value="_form.Name" />
            </div>

            @if (_editingUserId is null)
            {
                <div class="form-field">
                    <label for="staff-email">E-mail</label>
                    <InputText id="staff-email" class="form-control" type="email" @bind-Value="_form.Email" />
                </div>
            }

            <div class="form-field">
                <label for="staff-phone">Telefoon <span class="optional-label">optioneel</span></label>
                <InputText id="staff-phone" class="form-control" @bind-Value="_form.PhoneNumber" />
            </div>

            <div class="form-field">
                <label for="staff-wage">Uurloon (bruto, &euro;) <span class="optional-label">optioneel</span></label>
                <InputNumber id="staff-wage" class="form-control" step="0.01" @bind-Value="_form.HourlyWage" />
                <span class="field-helper">Gebruikt voor loonkosten in het rooster. Alleen zichtbaar voor jou.</span>
            </div>

            @if (_editingUserId is null)
            {
                <div class="form-field">
                    <label for="staff-password">Tijdelijk wachtwoord</label>
                    <InputText id="staff-password" class="form-control" type="password" @bind-Value="_form.TemporaryPassword" />
                    <span class="field-helper">Deel dit wachtwoord veilig met de medewerker.</span>
                </div>
            }

            <div class="form-actions">
                <button class="btn btn-primary w-100" type="submit" disabled="@_isSaving">
                    @(_isSaving
                        ? "Opslaan..."
                        : _editingUserId is null ? "Medewerker aanmaken" : "Wijzigingen opslaan")
                </button>
                @if (_editingUserId is not null)
                {
                    <button class="btn btn-quiet w-100" type="button" @onclick="CancelEdit">Annuleren</button>
                }
            </div>
        </EditForm>
    </SectionCard>

    <SectionCard Title="Teamoverzicht"
                 Subtitle="@($"{_staff.Count} medewerkers")"
                 CssClass="staff-overview-card">
        <Actions>
            <button class="btn btn-quiet btn-sm" type="button" @onclick="LoadAsync" disabled="@_isLoading">
                Vernieuwen
            </button>
        </Actions>
        <ChildContent>
            @if (_isLoading)
            {
                <div class="loading-state">Medewerkers laden...</div>
            }
            else if (_staff.Count == 0)
            {
                <EmptyState Icon="icon-users"
                            Title="Nog geen medewerkers"
                            Description="Voeg een medewerker toe zodat je team reserveringen kan beheren." />
            }
            else
            {
                <div class="staff-list">
                    @foreach (var staff in _staff.OrderBy(staff => staff.Name).ThenBy(staff => staff.Email))
                    {
                        <article class="staff-card">
                            <div class="staff-avatar">@GetInitials(staff.Name)</div>
                            <div class="staff-card-main">
                                <div class="staff-card-heading">
                                    <strong>@staff.Name</strong>
                                    <StatusBadge Label="@(staff.IsActive ? "Actief" : "Inactief")"
                                                 Tone="@(staff.IsActive ? StatusTone.Success : StatusTone.Neutral)" />
                                </div>
                                <span>@staff.Email</span>
                                <span>@(string.IsNullOrWhiteSpace(staff.PhoneNumber) ? "Geen telefoonnummer" : staff.PhoneNumber)</span>
                                <span>@(staff.HourlyWage is { } wage ? $"Uurloon {Money(wage)}" : "Geen uurloon ingesteld")</span>
                                <StatusBadge Label="@staff.Role" Tone="StatusTone.Info" />
                            </div>
                            <div class="staff-card-actions">
                                <button class="btn btn-quiet btn-sm"
                                        type="button"
                                        @onclick="() => StartEdit(staff)">
                                    Bewerken
                                </button>
                                <button class="btn btn-quiet btn-sm staff-toggle-button"
                                        type="button"
                                        disabled="@_updatingUserIds.Contains(staff.UserId)"
                                        @onclick="() => ToggleActiveAsync(staff)">
                                    @(staff.IsActive ? "Uitschakelen" : "Inschakelen")
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </ChildContent>
    </SectionCard>
</div>

@code {
    private StaffForm _form = new();
    private List<StaffUserDto> _staff = [];
    private readonly HashSet<Guid> _updatingUserIds = [];
    private Guid? _editingUserId;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _errorMessage;
    private string? _successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _staff = (await StaffApi.GetAllAsync()).ToList();
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartEdit(StaffUserDto staff)
    {
        _editingUserId = staff.UserId;
        _form = new StaffForm
        {
            Name = staff.Name,
            PhoneNumber = staff.PhoneNumber,
            HourlyWage = staff.HourlyWage,
            Email = staff.Email,
            TemporaryPassword = "-"
        };
        _successMessage = null;
        _errorMessage = null;
    }

    private void CancelEdit()
    {
        _editingUserId = null;
        _form = new StaffForm();
    }

    private async Task SaveAsync()
    {
        _isSaving = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            if (_editingUserId is { } userId)
            {
                var updated = await StaffApi.UpdateAsync(
                    userId,
                    new UpdateStaffRequest(_form.Name, _form.PhoneNumber, _form.HourlyWage));

                var index = _staff.FindIndex(existing => existing.UserId == userId);
                if (index >= 0)
                {
                    _staff[index] = updated;
                }

                _successMessage = "Medewerker bijgewerkt.";
                _editingUserId = null;
                _form = new StaffForm();
            }
            else
            {
                var created = await StaffApi.CreateAsync(
                    new CreateStaffRequest(
                        _form.Name,
                        _form.Email,
                        _form.TemporaryPassword,
                        _form.PhoneNumber,
                        _form.HourlyWage));

                _staff.Add(created);
                _successMessage = "Medewerker aangemaakt.";
                _form = new StaffForm();
            }
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleActiveAsync(StaffUserDto staff)
    {
        _errorMessage = null;
        _successMessage = null;
        _updatingUserIds.Add(staff.UserId);

        try
        {
            var updated = staff.IsActive
                ? await StaffApi.DisableAsync(staff.UserId)
                : await StaffApi.EnableAsync(staff.UserId);

            var index = _staff.FindIndex(existing => existing.UserId == staff.UserId);
            if (index >= 0)
            {
                _staff[index] = updated;
            }

            _successMessage = updated.IsActive
                ? "Medewerker ingeschakeld."
                : "Medewerker uitgeschakeld.";
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _updatingUserIds.Remove(staff.UserId);
        }
    }

    private static string Money(decimal value) => value.ToString("C", CultureInfo.GetCultureInfo("nl-NL"));

    private static string GetInitials(string name)
    {
        var parts = name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2);

        var initials = string.Concat(parts.Select(part => char.ToUpperInvariant(part[0])));
        return string.IsNullOrWhiteSpace(initials) ? "M" : initials;
    }

    private sealed class StaffForm
    {
        [Required(ErrorMessage = "Naam is verplicht.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "E-mail is verplicht.")]
        [EmailAddress(ErrorMessage = "Gebruik een geldig e-mailadres.")]
        public string Email { get; set; } = string.Empty;

        public string? PhoneNumber { get; set; }

        [Range(0, 999.99, ErrorMessage = "Uurloon moet tussen 0 en 1000 liggen.")]
        public decimal? HourlyWage { get; set; }

        [Required(ErrorMessage = "Tijdelijk wachtwoord is verplicht.")]
        public string TemporaryPassword { get; set; } = string.Empty;
    }
}
