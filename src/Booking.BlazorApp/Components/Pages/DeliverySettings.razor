@page "/admin/bezorging"
@attribute [Authorize(Roles = "Owner")]
@rendermode InteractiveServer
@inject DeliveryApiClient DeliveryApi

<PageTitle>Bezorgkoppelingen</PageTitle>

<section class="page-header">
    <div>
        <p class="eyebrow">Integraties</p>
        <h1>Bezorgplatformen</h1>
        <p class="text-muted mb-0">Bereid een cloudkoppeling of lokale kassaconnector voor.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_justConnected is not null)
{
    <div class="alert alert-success">
        <strong>Technische toegang voor @ProviderLabel(_justConnected.Provider) aangemaakt.</strong>
        Bewaar het secret nu; het wordt maar één keer getoond.
        <div class="secret-box">
            <div><span class="secret-label">Secret</span><code>@_justConnected.Secret</code></div>
        </div>
    </div>

    @if (_justConnected.Provider == DeliveryProvider.Thuisbezorgd)
    {
        <div class="integration-method-grid">
            <section class="integration-method-card">
                <span class="status-pill status-new">Cloudroute</span>
                <h2>JET Connect ingress</h2>
                <p>Laat Just Eat Takeaway orders naar dit publieke HTTPS-endpoint sturen tijdens partner-onboarding.</p>
                <div class="secret-box">
                    <div><span class="secret-label">Order-endpoint</span><code>@_justConnected.JetConnectOrderUrl</code></div>
                    <div><span class="secret-label">Authenticatieheader</span><code>X-JET-Connect-Secret: @_justConnected.Secret</code></div>
                </div>
            </section>
            <section class="integration-method-card">
                <span class="status-pill status-confirmed">Lokale route</span>
                <h2>T-Connect XML Connector</h2>
                <p>Installeer de Zambiq connector op dezelfde Windows-pc als de officiële T-Connect XML Client.</p>
                <div class="secret-box">
                    <div><span class="secret-label">Upload-endpoint</span><code>@_justConnected.TConnectOrderUrl</code></div>
                    <div><span class="secret-label">Startcommando</span><code>dotnet run --project src/Booking.TConnectConnector -- --api-url [publieke-api-url] --secret [secret]</code></div>
                </div>
            </section>
        </div>
    }
    else
    {
        <div class="secret-box mb-3">
            <div><span class="secret-label">Generiek testwebhook-endpoint</span><code>@_justConnected.WebhookUrl</code></div>
            <div><span class="secret-label">Authenticatieheader</span><code>X-Webhook-Secret: @_justConnected.Secret</code></div>
        </div>
    }
}

@if (_isLoading)
{
    <div class="loading-state">Laden...</div>
}
else
{
    <section class="content-section">
        <div class="list-stack">
            @foreach (var integration in _integrations)
            {
                <div class="list-row">
                    <div>
                        <strong>@ProviderLabel(integration.Provider)</strong>
                        <div class="text-muted small">
                            @if (!integration.Connected)
                            {
                                <span>Nog niet technisch geconfigureerd</span>
                            }
                            else if (integration.Enabled)
                            {
                                <span class="leave-badge leave-badge-approved">Toegang actief</span>
                            }
                            else
                            {
                                <span class="leave-badge leave-badge-denied">Uitgeschakeld</span>
                            }
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-primary btn-sm" @onclick="() => ConnectAsync(integration.Provider)"
                                disabled="@_busy">
                            @(integration.Connected ? "Secret vernieuwen" : "Technische toegang maken")
                        </button>
                        @if (integration.Connected && integration.Enabled)
                        {
                            <button class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => DisableAsync(integration.Provider)" disabled="@_busy">
                                Uitschakelen
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
        <p class="text-muted small mt-3">
            Een actieve technische toegang betekent niet automatisch dat het platform live gekoppeld is.
            Voor de cloudroute zijn JET Connect-partner-onboarding en certificering vereist.
            Voor de lokale route moet Thuisbezorgd de T-Connect XML Client voor het restaurant activeren.
        </p>
    </section>
}

@code {
    private List<DeliveryIntegrationDto> _integrations = [];
    private ConnectDeliveryDto? _justConnected;
    private bool _isLoading = true;
    private bool _busy;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _integrations = (await DeliveryApi.GetIntegrationsAsync()).ToList();
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ConnectAsync(DeliveryProvider provider)
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            _justConnected = await DeliveryApi.ConnectAsync(provider);
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DisableAsync(DeliveryProvider provider)
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            await DeliveryApi.DisableAsync(provider);
            await LoadAsync();
        }
        catch (ApiClientException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ProviderLabel(DeliveryProvider provider)
    {
        return provider switch
        {
            DeliveryProvider.Thuisbezorgd => "Thuisbezorgd",
            DeliveryProvider.UberEats => "Uber Eats",
            _ => provider.ToString()
        };
    }
}
