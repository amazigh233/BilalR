{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "Booking.Api",
      "Audience": "Booking.BlazorApp",
      "TokenLifetimeMinutes": 480
    }
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "UseSsl": true,
    "FromAddress": "no-reply@zambiq.local",
    "FromName": "Zambiq"
  },
  "RateLimiting": {
    "Public": {
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "AllowedHosts": "*"
}
