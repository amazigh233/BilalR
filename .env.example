SA_PASSWORD=ChangeThis_StrongPassword_123!
DB_NAME=BookingDb
API_URL=http://booking-api:8080
# Public HTTPS API address used in delivery connector URLs and uploaded widget logos.
PUBLIC_API_URL=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Staging
JWT_SIGNING_KEY=ChangeThis_To_A_Long_Random_Signing_Key_At_Least_32_Chars

# Optional local dev seed. Keep disabled on production-like VPS environments.
AUTH_DEV_SEED_ENABLED=true
DEV_SUPERADMIN_EMAIL=superadmin@zambiq.local
DEV_SUPERADMIN_PASSWORD=ChangeThis_LocalSuperAdmin_123!
DEV_OWNER_PASSWORD=ChangeThis_LocalOwner_123!
DEV_STAFF_PASSWORD=ChangeThis_LocalStaff_123!
DEV_SECOND_OWNER_PASSWORD=ChangeThis_LocalOwnerB_123!

# E-mail (SMTP). Leave Email__SmtpHost empty to use the logging-only fallback (no real e-mail).
# Provide real values via environment variables on production-like environments; never commit secrets.
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUsername=
Email__SmtpPassword=
Email__UseSsl=true
Email__FromAddress=no-reply@zambiq.local
Email__FromName=Zambiq

# Optional local host ports. Local EF commands in this repo use localhost,1434.
SQL_PORT=1434
API_PORT=5000
BLAZOR_PORT=5001

# Platformbrede nood-allowlist. Restaurantwebsites worden via /admin/widget beheerd.
WIDGET_ALLOWED_FRAME_ANCESTORS="'self'"

# Boekhouding-light. Laat connectorcredentials leeg om alleen handmatige invoer en CSV-import te gebruiken.
ACCOUNTING_GOCARDLESS_SECRET_ID=
ACCOUNTING_GOCARDLESS_SECRET_KEY=
ACCOUNTING_GOCARDLESS_REDIRECT_URL=http://localhost:5001/admin/boekhouding/importeren
ACCOUNTING_MOLLIE_CLIENT_ID=
ACCOUNTING_MOLLIE_CLIENT_SECRET=
ACCOUNTING_MOLLIE_REDIRECT_URL=http://localhost:5001/admin/boekhouding/importeren

# Google Business Profile. Zet GoogleBusiness__Enabled=true zodra de GCP API-toegang is goedgekeurd.
# Zie SETUP.md voor instructies om API-toegang aan te vragen.
GoogleBusiness__Enabled=false
GoogleBusiness__ClientId=
GoogleBusiness__ClientSecret=
GoogleBusiness__RedirectUrl=http://localhost:5001/gbp-callback
